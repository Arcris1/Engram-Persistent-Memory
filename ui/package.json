{
  "name": "engram-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Local web UI for engram: loopback-only server and web app",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
